# LEGO defconfig
apply_defconfig_fragment ${KERNEL_DIR}/lego.config vendor/${MSM_ARCH}-gki_defconfig

# DEFCONFIG base
apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_sec_defconfig vendor/${MSM_ARCH}-gki_defconfig

# DEBUG_DEFCONFIG
if [[ "${TARGET_BUILD_VARIANT}" != "user" ]]; then
	apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_sec_${TARGET_BUILD_VARIANT}_defconfig vendor/${MSM_ARCH}-gki_defconfig
fi

# VARIANT_DEFCONFIG
# apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_sec_${TARGET_VARIANT}_defconfig vendor/${MSM_ARCH}-gki_defconfig

# Optional NetHunter compatibility fragment for sec gki builds.
# Enable with NETHUNTER_ENABLE=1.
#
# The waipio GKI path is a mixed build: build.config.msm.gki sets
# MAKE_GOALS="modules dtbs" and GKI_BUILD_CONFIG=common/build.config.gki.aarch64,
# so the shipped Image comes from the recursive GKI build.  Built-in options
# (=y) must therefore be injected into that build via GKI_DEFCONFIG_FRAGMENT.
# Module-capable drivers are applied here as vendor modules.
if [[ "${NETHUNTER_ENABLE:-0}" == "1" ]]; then
	# Pass =y built-ins to the recursive GKI kernel build so they are
	# compiled into the shipped Image.
	export GKI_DEFCONFIG_FRAGMENT="${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_nethunter_gki_builtin.config"

	# Apply module-capable NetHunter drivers to the vendor defconfig.
	apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${MSM_ARCH}_nethunter_gki.fragment vendor/${MSM_ARCH}-gki_defconfig
fi
