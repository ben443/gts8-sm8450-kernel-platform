# GKI_DEFCONFIG_FRAGMENT for NetHunter built-in options on SM8450 waipio.
#
# Sourced by common/build.config.gki.aarch64 during the recursive GKI
# kernel build so that the listed symbols end up compiled into the
# shipped GKI Image.
#
# Module-capable NetHunter drivers are kept in
# waipio_nethunter_gki.fragment and built as vendor modules instead.

NETHUNTER_BUILTIN_FRAGMENT="${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/vendor/waipio_nethunter_gki_builtin.fragment"

PRE_DEFCONFIG_CMDS="${PRE_DEFCONFIG_CMDS} && \
  KCONFIG_CONFIG=\${ROOT_DIR}/\${KERNEL_DIR}/arch/arm64/configs/gki_defconfig \
  \${ROOT_DIR}/\${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -r \
  \${ROOT_DIR}/\${KERNEL_DIR}/arch/arm64/configs/gki_defconfig \
  ${NETHUNTER_BUILTIN_FRAGMENT}"
