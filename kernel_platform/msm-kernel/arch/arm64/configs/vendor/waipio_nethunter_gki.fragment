# NetHunter compatibility fragment for SM8450 waipio GKI (5.10)
#
# Keep this focused on options that are not already enabled by the stock
# waipio Samsung sec gki defconfig chain.

# USB gadget and host features used by NetHunter tooling
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_USB_CONFIGFS_F_UAC1_LEGACY=y
CONFIG_USB_MON=y

# USB serial and modem adapters
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m

# Extra USB networking modes
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m

# External Bluetooth USB dongles and PAN profile
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# External Wi-Fi adapter support (monitor/injection capable chipsets)
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_ATH9K_HTC=m
CONFIG_MT7601U=m
CONFIG_R8188EU=m
CONFIG_RT2X00=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RTL8XXXU=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
