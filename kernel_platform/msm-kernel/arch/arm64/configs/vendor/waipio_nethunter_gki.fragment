# NetHunter vendor module fragment for SM8450 waipio GKI (5.10)
#
# This fragment is applied to the vendor (MSM) defconfig and contains only
# module-capable (=m) drivers.  Built-in (=y) options that must be compiled
# into the GKI Image are kept in waipio_nethunter_gki_builtin.fragment and
# are injected into the GKI build via GKI_DEFCONFIG_FRAGMENT in
# build.config.sec.

# USB serial and modem adapters (vendor modules)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m

# Extra USB networking modes (vendor modules)
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m

# External Bluetooth USB dongles (vendor modules)
CONFIG_BT_HCIBTUSB=m

# External Wi-Fi adapter support - monitor/injection capable chipsets (vendor modules)
CONFIG_ATH9K_HTC=m
CONFIG_MT7601U=m
CONFIG_R8188EU=m
CONFIG_RT2X00=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RTL8XXXU=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m

